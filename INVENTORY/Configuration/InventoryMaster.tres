[gd_resource type="Resource" script_class="InventorySettings" load_steps=13 format=3]
[ext_resource type="Script" path="res://INVENTORY/InventorySettings.cs" id="settings"]
[ext_resource type="Script" path="res://INVENTORY/ItemDefinition.cs" id="item"]
