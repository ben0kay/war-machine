[ext_resource type="Texture2D" path="res://UI/GameplayHUD/Inventory/Icons/bandage.svg" id="bandage_icon"]
[ext_resource type="Texture2D" path="res://UI/GameplayHUD/Inventory/Icons/ammo.svg" id="ammo_icon"]
[sub_resource type="Resource" id="Water"]
